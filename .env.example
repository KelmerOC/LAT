APP_NAME="LAT Lacteos Compacto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/lat-compacto

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lat_compacto_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LAT_COMISION=0.00
LAT_TEMP_PASTEURIZACION=72
LAT_TEMP_INOCULACION_MIN=36
LAT_TEMP_INOCULACION_MAX=40
